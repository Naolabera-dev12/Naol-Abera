    printf("\nEnter filename to decrypt (without extension): ");
    scanf("%s", filename);
    strcat(filename, ".doc");

    fp = fopen(filename, "r");
    if (fp == NULL) {
        printf(" File not found.\n");
        return;
    }

    printf("\n Decrypted Content:\n");
    while ((ch = fgetc(fp)) != EOF) {
        if (ch >= 32 && ch <= 126)
